# 복사해서 .env를 만들고 값을 채우세요:  cp .env.example .env
# .env는 git에 올리지 않습니다.

# ---- DB ----
POSTGRES_USER=hankovillage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hankovillage
DB_HOST=db
DB_PORT=5432

# ---- JWT (서로 다른 무작위 값, 43자 이상) ----
# 만들기: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_ACCESS_SECRET=change-me-access
JWT_SIGNUP_SECRET=change-me-signup

# ---- 소셜 로그인 ----
# 카카오 개발자 콘솔의 네이티브 앱 키(앱이 쓰는 키와 같은 값). ID 토큰의 aud와 비교합니다.
KAKAO_NATIVE_APP_KEY=change-me-kakao-native-app-key
# 구글 클라우드 콘솔의 "웹 애플리케이션" 유형 클라이언트 ID(앱의 serverClientId와 같은 값). ID 토큰의 aud와 비교합니다.
GOOGLE_WEB_CLIENT_ID=change-me-google-web-client-id

# ---- 사진 저장소 ----
# 노트북은 local(컨테이너 안 폴더), 서버는 oci(Object Storage, 인스턴스 주체 인증이라 키 없음)
STORAGE_BACKEND=local
# 아래는 기본값과 같으면 생략 가능
# OCI_REGION=ap-tokyo-1
# OCI_PRIVATE_BUCKET=hanko-private
