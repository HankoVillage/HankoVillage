# 복사해서 .env를 만들고 값을 채우세요:  cp .env.example .env
# .env는 git에 올리지 않습니다.

# ---- DB ----
POSTGRES_USER=hankovillage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hankovillage
DB_HOST=db
DB_PORT=5432

# ---- JWT (서로 다른 무작위 값, 43자 이상) ----
# 만들기: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_ACCESS_SECRET=change-me-access
JWT_SIGNUP_SECRET=change-me-signup

# ---- 소셜 로그인 ----
# 카카오 개발자 콘솔의 네이티브 앱 키(앱이 쓰는 키와 같은 값). ID 토큰의 aud와 비교합니다.
KAKAO_NATIVE_APP_KEY=change-me-kakao-native-app-key
